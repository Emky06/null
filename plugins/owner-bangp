//Plugin fatto da Axtral_WiZaRd
import fs from 'fs'

const fileDB = './banned.json'

function loadDB() {
  if (!fs.existsSync(fileDB)) return {}
  return JSON.parse(fs.readFileSync(fileDB))
}

function saveDB(db) {
  fs.writeFileSync(fileDB, JSON.stringify(db, null, 2))
}

async function handler(m, { isBotAdmin, text, conn }) {
  if (!isBotAdmin) return m.reply('ⓘ 𝐃𝐞𝐯𝐨 𝐞𝐬𝐬𝐞𝐫𝐞 𝐚𝐝𝐦𝐢𝐧 𝐩𝐞𝐫 𝐩𝐨𝐭𝐞𝐫 𝐟𝐮𝐧𝐳𝐢𝐨𝐧𝐚𝐫𝐞.')

  const mention = m.mentionedJid?.[0] || m.quoted?.sender
  if (!mention) return m.reply('ⓘ 𝐌𝐞𝐧𝐳𝐢𝐨𝐧𝐚 𝐥\'𝐮𝐭𝐞𝐧𝐭𝐞 𝐝𝐚 𝐛𝐚𝐧𝐧𝐚𝐫𝐞.')

  const motivo = text ? text.replace(/@[\d\-]+/, '').trim() || '𝐧𝐨𝐧 𝐬𝐩𝐞𝐜𝐢𝐟𝐢𝐜𝐚𝐭𝐨' : '𝐧𝐨𝐧 𝐬𝐩𝐞𝐜𝐢𝐟𝐢𝐜𝐚𝐭𝐨'

  const ownerBot = global.owner?.[0]?.[0] + '@s.whatsapp.net'
  if (mention === ownerBot) return m.reply('ⓘ 𝐍𝐨𝐧 𝐩𝐮𝐨𝐢 𝐛𝐚𝐧𝐧𝐚𝐫𝐞 𝐢𝐥 𝐜𝐫𝐞𝐚𝐭𝐨𝐫𝐞 𝐝𝐞𝐥 𝐛𝐨𝐭.')
  if (mention === conn.user.jid) return m.reply('ⓘ 𝐍𝐨𝐧 𝐩𝐮𝐨𝐢 𝐛𝐚𝐧𝐧𝐚𝐫𝐞 𝐢𝐥 𝐛𝐨𝐭.')
  if (mention === m.sender) return m.reply('ⓘ 𝐍𝐨𝐧 𝐩𝐮𝐨𝐢 𝐛𝐚𝐧𝐧𝐚𝐫𝐞 𝐭𝐞 𝐬𝐭𝐞𝐬𝐬𝐨.')

  const groupMetadata = conn.chats[m.chat]?.metadata
  const participants = groupMetadata?.participants || []
  const utente = participants.find(u => conn.decodeJid(u.id) === mention)

  const owner = utente?.admin === 'superadmin'
  const admin = utente?.admin === 'admin'
  if (owner) return m.reply('⚠️ 𝐋\'𝐮𝐭𝐞𝐧𝐭𝐞 è 𝐢𝐥 𝐜𝐫𝐞𝐚𝐭𝐨𝐫𝐞 𝐝𝐞𝐥 𝐠𝐫𝐮𝐩𝐩𝐨.')
  if (admin) return m.reply('⚠️ 𝐋\'𝐮𝐭𝐞𝐧𝐭𝐞 è 𝐚𝐝𝐦𝐢𝐧, 𝐢𝐦𝐩𝐨𝐬𝐬𝐢𝐛𝐢𝐥𝐞 𝐛𝐚𝐧𝐧𝐚𝐫𝐥𝐨.')

  let db = loadDB()
  if (!db[m.chat]) db[m.chat] = []
  if (!db[m.chat].includes(mention)) {
    db[m.chat].push(mention)
    saveDB(db)
  }

  const userTag = `@${mention.split('@')[0]}`
  const senderTag = `@${m.sender.split('@')[0]}`
  const messaggio =
`╭━━━[ *𝐏𝐞𝐫𝐦𝐚 𝐁𝐚𝐧* ]━━━╮
┃ 👤 𝐔𝐭𝐞𝐧𝐭𝐞: ${userTag}
┃ 🚫 𝐁𝐚𝐧𝐧𝐚𝐭𝐨 𝐝𝐚: ${senderTag}
┃ ❓ 𝐌𝐨𝐭𝐢𝐯𝐨: ${motivo}
╰━━━━━━━━━━━━━━━━━━━╯`

  m.reply(messaggio, null, { mentions: [mention, m.sender] })
  conn.groupParticipantsUpdate(m.chat, [mention], 'remove')
}

async function handlerJoin(m, { conn }) {
  if (!m.isGroup) return
  let db = loadDB()
  let bannedList = db[m.chat] || []

  for (let user of m.participantsAdded || []) {
    if (bannedList.includes(user)) {
      await conn.groupParticipantsUpdate(m.chat, [user], 'remove')
      conn.reply(m.chat, `🚫 𝐔𝐭𝐞𝐧𝐭𝐞 @${user.split('@')[0]} 𝐞̀ 𝐛𝐚𝐧𝐧𝐚𝐭𝐨 𝐞 𝐧𝐨𝐧 𝐩𝐮𝐨̀ 𝐫𝐢𝐞𝐧𝐭𝐫𝐚𝐫𝐞.`, null, { mentions: [user] })
    }
  }
}

handler.command = /^(axtralpoof|kinderpoof)$/i
handler.owner = true
handlerJoin.event = 'group-participants.update'

export default handler
export { handlerJoin }
